{
  "manifest_version": 3,
  "name": "المساعد الصوتي الذكي (Smart Voice Assistant)",
  "version": "1.0",
  "description": "إضافة متصفح لتحويل الكلام إلى نص مباشرةً مع أيقونة عائمة قابلة للسحب والتحريك",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_title": "المساعد الصوتي الذكي",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-voice-assistant": {
      "suggested_key": {
        "default": "Ctrl+Shift+V"
      },
      "description": "إظهار/إخفاء المساعد الصوتي"
    }
  }
}